# Cổng ứng dụng sẽ chạy (mặc định: 3000)
PORT=3000

# Chế độ môi trường (development/production)
NODE_ENV=development

# URI kết nối MongoDB 
# Local: mongodb://127.0.0.1:27017/it_equipment
# Docker: mongodb://mongodb:27017/it_equipment
MONGO_URI=mongodb://127.0.0.1:27017/it_equipment

# Chuỗi bí mật dùng để ký và mã hóa Token JWT (Tạo chuỗi ngẫu nhiên dài)
JWT_SECRET=your_jwt_secret_key_here

# API Key cho dịch vụ lưu trữ ảnh ImgBB (https://imgbb.com/)
IMGBB_API_KEY=your_imgbb_api_key_here

# Cấu hình gửi Mail OTP qua Gmail
# GMAIL_USER: Địa chỉ email gửi
# GMAIL_PASS: App Password (không phải mật khẩu chính)
GMAIL_USER=your_email@gmail.com
GMAIL_PASS=your_app_password_here
