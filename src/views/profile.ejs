<%- include('./layouts/header') %>

<div class="max-w-2xl space-y-6">
    <!-- Profile Card -->
    <div class="bg-white rounded-xl shadow-lg border border-gray-200 p-8">
        <div class="flex items-center gap-5 pb-6 border-b border-gray-200">
            <div class="relative group">
                <div class="w-24 h-24 rounded-full overflow-hidden border-4 border-white shadow-md ring-2 ring-blue-500/20 bg-gray-50 flex items-center justify-center">
                    <% if (profile.avatar) { %>
                        <img id="avatarPreview" src="<%= profile.avatar %>" alt="Avatar" class="w-full h-full object-cover">
                    <% } else { %>
                        <div id="avatarFallback" class="w-full h-full bg-gradient-to-br from-blue-500 to-indigo-600 flex items-center justify-center text-white text-4xl font-black uppercase">
                            <%= profile.username.charAt(0) %>
                        </div>
                    <% } %>
                </div>
                <form action="/auth/profile/avatar" method="POST" enctype="multipart/form-data" class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-300 bg-black/50 rounded-full backdrop-blur-[2px]">
                    <label for="avatarInput" class="cursor-pointer text-white text-[10px] font-extrabold tracking-wider uppercase flex flex-col items-center gap-1">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
                        Thay đổi
                    </label>
                    <input type="file" id="avatarInput" name="avatar" accept="image/*" class="hidden" onchange="this.form.submit()">
                </form>
            </div>
            <div>
                <h2 class="text-2xl font-bold text-gray-800"><%= locals.user.username %></h2>
                <span class="inline-block mt-1 text-xs font-bold px-3 py-1 rounded-full <%= locals.user.role === 'admin' ? 'bg-purple-100 text-purple-700' : 'bg-blue-100 text-blue-700' %>">
                    <%= locals.user.role === 'admin' ? '👑 Admin' : '👤 User' %>
                </span>
            </div>
        </div>

        <dl class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
            <div class="bg-gray-50 rounded-lg px-4 py-3">
                <dt class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1">Tên đăng nhập</dt>
                <dd class="font-semibold text-gray-800"><%= profile.username %></dd>
            </div>
            <div class="bg-gray-50 rounded-lg px-4 py-3">
                <dt class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1">Vai trò</dt>
                <dd class="font-semibold text-gray-800"><%= profile.role === 'admin' ? 'Quản trị viên' : 'Người dùng' %></dd>
            </div>
            <div class="bg-gray-50 rounded-lg px-4 py-3">
                <dt class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1">Ngày tạo tài khoản</dt>
                <dd class="font-semibold text-gray-800"><%= new Date(profile.createdAt).toLocaleDateString('vi-VN', {year:'numeric',month:'long',day:'numeric'}) %></dd>
            </div>
            <div class="bg-gray-50 rounded-lg px-4 py-3">
                <dt class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1">Cập nhật lần cuối</dt>
                <dd class="font-semibold text-gray-800"><%= new Date(profile.updatedAt).toLocaleDateString('vi-VN', {year:'numeric',month:'long',day:'numeric'}) %></dd>
            </div>
        </dl>
    </div>

    <!-- Change Password -->
    <div class="bg-white rounded-xl shadow-lg border border-gray-200 p-8">
        <h3 class="text-lg font-bold text-gray-800 mb-6 flex items-center gap-2">&#128274; Đổi mật khẩu</h3>

        <% if (error) { %>
        <div class="bg-red-50 border-l-4 border-red-500 text-red-700 rounded-lg px-4 py-3 mb-5 text-sm flex items-start gap-2">
            <span>&#9888;</span><span><%= error %></span>
        </div>
        <% } %>
        <% if (success) { %>
        <div class="bg-green-50 border-l-4 border-green-500 text-green-700 rounded-lg px-4 py-3 mb-5 text-sm flex items-start gap-2">
            <span>&#10003;</span><span><%= success %></span>
        </div>
        <% } %>

        <form action="/auth/profile/change-password" method="POST" class="space-y-5">
            <div>
                <label class="block text-sm font-bold text-gray-700 mb-2">Mật khẩu hiện tại <span class="text-red-500">*</span></label>
                <div class="relative max-w-sm">
                    <input type="password" id="currentPassword" name="currentPassword" required
                        placeholder="Nhập mật khẩu hiện tại"
                        class="w-full border-2 border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-200 bg-gray-50 hover:bg-white pr-10 transition">
                    <button type="button" onclick="togglePwd(this,'currentPassword')" class="absolute right-3 top-2.5 text-gray-400 hover:text-gray-600 p-0.5 cursor-pointer active:scale-110">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                    </button>
                </div>
            </div>
            <div>
                <label class="block text-sm font-bold text-gray-700 mb-2">Mật khẩu mới <span class="text-red-500">*</span></label>
                <div class="relative max-w-sm">
                    <input type="password" id="newPassword" name="newPassword" required minlength="6"
                        placeholder="Tối thiểu 6 ký tự"
                        class="w-full border-2 border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-200 bg-gray-50 hover:bg-white pr-10 transition">
                    <button type="button" onclick="togglePwd(this,'newPassword')" class="absolute right-3 top-2.5 text-gray-400 hover:text-gray-600 p-0.5 cursor-pointer active:scale-110">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                    </button>
                </div>
            </div>
            <div>
                <label class="block text-sm font-bold text-gray-700 mb-2">Xác nhận mật khẩu mới <span class="text-red-500">*</span></label>
                <div class="relative max-w-sm">
                    <input type="password" id="confirmNewPassword" name="confirmNewPassword" required minlength="6"
                        placeholder="Nhập lại mật khẩu mới"
                        class="w-full border-2 border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-200 bg-gray-50 hover:bg-white pr-10 transition">
                    <button type="button" onclick="togglePwd(this,'confirmNewPassword')" class="absolute right-3 top-2.5 text-gray-400 hover:text-gray-600 p-0.5 cursor-pointer active:scale-110">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                    </button>
                </div>
            </div>

            <button type="submit"
                class="bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white font-bold px-6 py-2.5 rounded-lg transition-all shadow-md hover:shadow-lg active:scale-95 cursor-pointer">
                &#128190; Lưu mật khẩu mới
            </button>
        </form>
    </div>
</div>

<script>
    const EYE_OPEN = '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>';
    const EYE_CLOSED = '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24M1 1l22 22"/></svg>';
    function togglePwd(btn, id) {
        const input = document.getElementById(id);
        if (input.type === 'password') { input.type = 'text'; btn.innerHTML = EYE_CLOSED; }
        else { input.type = 'password'; btn.innerHTML = EYE_OPEN; }
    }

    // Real-time confirm password check
    const newPwd = document.getElementById('newPassword');
    const confirmPwd = document.getElementById('confirmNewPassword');
    function checkMatch() {
        if (newPwd.value && confirmPwd.value) {
            confirmPwd.style.borderColor = newPwd.value === confirmPwd.value ? '#22c55e' : '#ef4444';
        } else {
            confirmPwd.style.borderColor = '';
        }
    }
    newPwd.addEventListener('input', checkMatch);
    confirmPwd.addEventListener('input', checkMatch);
</script>

<%- include('./layouts/footer') %>
