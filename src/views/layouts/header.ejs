<% if (typeof title === 'undefined') { title = ''; } %>
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | IT Equipment Manager</title>
    <link rel="stylesheet" href="/stylesheets/output.css">
</head>
<body class="bg-gray-50 min-h-screen">

<% if (locals.user) { %>
<div class="flex min-h-screen">
    <%- include('./sidebar') %>
    <div class="flex-1 flex flex-col min-w-0">
        <header class="bg-white shadow-sm px-6 py-4 border-b border-gray-200 sticky top-0 z-40">
            <div class="flex justify-between items-center">
                <div class="flex-1">
                    <h1 class="text-2xl font-bold bg-gradient-to-r from-blue-600 to-indigo-600 bg-clip-text text-transparent"><%= title %></h1>
                    <p class="text-xs text-gray-500 mt-0.5">Quản lý thiết bị IT - Hệ thống tập trung</p>
                </div>
                <div class="flex items-center gap-3">
                    <!-- Notification Bell -->
                    <div class="relative" id="notifContainer">
                        <button id="notifBtn"
                            class="p-2 hover:bg-gray-100 rounded-lg transition-colors relative" title="Thông báo">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                            <span id="notifDot" class="absolute top-1 right-1 w-2 h-2 bg-red-500 rounded-full hidden"></span>
                        </button>
                        <!-- Notification Dropdown -->
                        <div id="notifDropdown"
                            class="absolute right-0 mt-2 w-80 bg-white rounded-xl shadow-xl border border-gray-200 z-50 hidden">
                            <div class="px-4 py-3 border-b border-gray-100 flex items-center justify-between">
                                <span class="font-bold text-sm text-gray-800">Thông báo</span>
                                <span id="notifCount" class="text-xs text-gray-400"></span>
                            </div>
                            <div id="notifList" class="max-h-72 overflow-y-auto divide-y divide-gray-50">
                                <div class="px-4 py-6 text-center text-sm text-gray-400">Đang tải...</div>
                            </div>
                            <div class="px-4 py-2.5 border-t border-gray-100 text-center">
                                <a href="/equipment" class="text-xs text-blue-600 hover:text-blue-800 font-semibold">Xem tất cả thiết bị →</a>
                            </div>
                        </div>
                    </div>
                    
                    <!-- User Dropdown Menu — click to open -->
                    <div class="relative" id="userMenuContainer">
                        <button type="button" id="userMenuBtn"
                            class="flex items-center gap-2 px-3 py-2 hover:bg-gray-100 rounded-lg transition-colors cursor-pointer">
                            <span class="text-sm font-medium text-gray-700"><%= locals.user.username %></span>
                            <span class="text-xs">&#9662;</span>
                        </button>
                        <!-- Dropdown Menu -->
                        <div id="userMenuDropdown" class="absolute right-0 mt-1 w-48 bg-white rounded-lg shadow-lg border border-gray-200 py-2 z-50 hidden">
                            <a href="/auth/profile" class="flex items-center gap-2 px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50 transition">&#128100; Hồ sơ cá nhân</a>
                            <a href="/auth/settings" class="flex items-center gap-2 px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50 transition">&#9881; Cài đặt</a>
                            <hr class="border-gray-200 my-1">
                            <form action="/auth/logout" method="POST" class="block">
                                <button type="submit" class="w-full text-left flex items-center gap-2 px-4 py-2.5 text-sm text-red-600 hover:bg-red-50 transition-all font-medium cursor-pointer active:scale-95 shadow-sm hover:shadow-md">
                                    &#128682; Đăng xuất
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </header>
        <main class="p-6 flex-1 overflow-y-auto">
<% } %>
