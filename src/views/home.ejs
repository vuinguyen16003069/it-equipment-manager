<%- include('layouts/header') %>

<div class="space-y-8 pb-10">
    <!-- Welcome Header -->
    <div class="relative overflow-hidden bg-gradient-to-r from-blue-600 to-indigo-700 rounded-3xl p-8 text-white shadow-2xl">
        <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
            <div>
                <h1 class="text-3xl md:text-4xl font-black mb-2 tracking-tight">Chào mừng quay trở lại, <%= user.name %>! 👋</h1>
                <p class="text-blue-100 text-lg opacity-90">Hệ thống quản lý thiết bị IT của bạn đang vận hành ổn định.</p>
            </div>
            <div class="flex gap-4">
                <a href="/equipment/create" class="bg-white text-blue-600 font-bold px-6 py-3 rounded-xl shadow-lg hover:bg-blue-50 transition-all flex items-center gap-2 transform hover:-translate-y-1 active:scale-95">
                    <span class="text-xl">+</span>
                    <span>Thêm thiết bị</span>
                </a>
            </div>
        </div>
        <!-- Decorative Shapes -->
        <div class="absolute -top-12 -right-12 w-64 h-64 bg-white/10 rounded-full blur-3xl"></div>
        <div class="absolute -bottom-8 left-1/4 w-32 h-32 bg-indigo-400/20 rounded-full blur-2xl"></div>
    </div>

    <!-- Quick Stats Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Total Card -->
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 hover:shadow-xl transition-all group">
            <div class="flex items-center justify-between mb-4">
                <div class="w-12 h-12 bg-blue-50 text-blue-600 rounded-xl flex items-center justify-center text-2xl group-hover:bg-blue-600 group-hover:text-white transition-colors">
                    &#128187;
                </div>
                <span class="text-[10px] font-black text-blue-500 uppercase tracking-widest bg-blue-50 px-2 py-1 rounded-full">Tổng số</span>
            </div>
            <p class="text-3xl font-black text-gray-900 mb-1"><%= stats.total %></p>
            <p class="text-sm text-gray-500 font-medium">Thiết bị trong kho</p>
        </div>

        <!-- Available Card -->
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 hover:shadow-xl transition-all group">
            <div class="flex items-center justify-between mb-4">
                <div class="w-12 h-12 bg-emerald-50 text-emerald-600 rounded-xl flex items-center justify-center text-2xl group-hover:bg-emerald-600 group-hover:text-white transition-colors">
                    &#9989;
                </div>
                <span class="text-[10px] font-black text-emerald-500 uppercase tracking-widest bg-emerald-50 px-2 py-1 rounded-full">Sẵn sàng</span>
            </div>
            <p class="text-3xl font-black text-gray-900 mb-1"><%= stats.available %></p>
            <p class="text-sm text-gray-500 font-medium">Có thể bàn giao ngay</p>
        </div>

        <!-- In-use Card -->
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 hover:shadow-xl transition-all group">
            <div class="flex items-center justify-between mb-4">
                <div class="w-12 h-12 bg-amber-50 text-amber-600 rounded-xl flex items-center justify-center text-2xl group-hover:bg-amber-600 group-hover:text-white transition-colors">
                    &#128100;
                </div>
                <span class="text-[10px] font-black text-amber-500 uppercase tracking-widest bg-amber-50 px-2 py-1 rounded-full">Đang dùng</span>
            </div>
            <p class="text-3xl font-black text-gray-900 mb-1"><%= stats.inUse %></p>
            <p class="text-sm text-gray-500 font-medium">Đã được cấp phát</p>
        </div>

        <!-- Maintenance/Retired Combined -->
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 hover:shadow-xl transition-all group">
            <div class="flex items-center justify-between mb-4">
                <div class="w-12 h-12 bg-rose-50 text-rose-600 rounded-xl flex items-center justify-center text-2xl group-hover:bg-rose-600 group-hover:text-white transition-colors">
                    &#9888;
                </div>
                <span class="text-[10px] font-black text-rose-500 uppercase tracking-widest bg-rose-50 px-2 py-1 rounded-full">Cần lưu ý</span>
            </div>
            <p class="text-3xl font-black text-gray-900 mb-1"><%= stats.maintenance + stats.retired %></p>
            <p class="text-sm text-gray-500 font-medium">Bảo trì hoặc đã thanh lý</p>
        </div>
    </div>

    <!-- Secondary Info Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <div class="lg:col-span-2 space-y-8">
            <div class="bg-white rounded-3xl p-8 border border-gray-100 shadow-sm">
                <div class="flex items-center justify-between mb-8">
                    <h2 class="text-xl font-black text-gray-900 flex items-center gap-3">
                        <span class="w-1.5 h-6 bg-blue-600 rounded-full"></span>
                        Lối tắt nhanh
                    </h2>
                </div>
                <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
                    <a href="/equipment" class="flex flex-col items-center justify-center p-6 rounded-2xl bg-gray-50 border border-gray-100 hover:bg-blue-50 hover:border-blue-200 transition-all group">
                        <span class="text-3xl mb-3 group-hover:scale-110 transition-transform">&#128221;</span>
                        <span class="text-sm font-bold text-gray-700">Xem danh sách</span>
                    </a>
                    <a href="/equipment?status=available" class="flex flex-col items-center justify-center p-6 rounded-2xl bg-gray-50 border border-gray-100 hover:bg-emerald-50 hover:border-emerald-200 transition-all group">
                        <span class="text-3xl mb-3 group-hover:scale-110 transition-transform">&#128230;</span>
                        <span class="text-sm font-bold text-gray-700">Kho sẵn sàng</span>
                    </a>
                    <a href="/auth/profile" class="flex flex-col items-center justify-center p-6 rounded-2xl bg-gray-50 border border-gray-100 hover:bg-purple-50 hover:border-purple-200 transition-all group">
                        <span class="text-3xl mb-3 group-hover:scale-110 transition-transform">&#9881;</span>
                        <span class="text-sm font-bold text-gray-700">Cài đặt hồ sơ</span>
                    </a>
                </div>
            </div>

            <div class="bg-indigo-50 rounded-3xl p-8 border border-indigo-100 relative overflow-hidden">
                <div class="relative z-10 flex items-start gap-4">
                    <div class="text-3xl text-indigo-600">&#128161;</div>
                    <div>
                        <h3 class="font-bold text-indigo-900 mb-1">Mẹo nhỏ cho bạn</h3>
                        <p class="text-sm text-indigo-700 leading-relaxed">Bạn có thể ấn trực tiếp vào các hàng trong danh sách thiết bị để xem chi tiết thông tin và hồ sơ thiết bị mà không cần vào chế độ chỉnh sửa.</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="space-y-8">
            <% if (locals.user && locals.user.role === 'admin') { %>
            <div class="bg-white rounded-3xl p-8 border border-gray-100 shadow-sm text-center">
                <div class="w-16 h-16 bg-orange-50 text-orange-600 rounded-2xl flex items-center justify-center text-3xl mx-auto mb-4">
                    &#128101;
                </div>
                <h3 class="text-lg font-black text-gray-900 mb-1">Quản lý nhân sự</h3>
                <p class="text-3xl font-black text-orange-600 mb-4"><%= userCount %></p>
                <a href="/users" class="block w-full py-3 bg-gray-900 text-white font-bold rounded-xl hover:bg-gray-800 transition-all active:scale-95 text-sm">
                    Xem tất cả người dùng
                </a>
            </div>
            <% } %>

            <div class="bg-white rounded-3xl p-8 border border-gray-100 shadow-sm">
                <h2 class="text-sm font-black text-gray-400 uppercase tracking-widest mb-6">Trạng thái hệ thống</h2>
                <div class="space-y-4">
                    <div class="flex items-center justify-between text-sm">
                        <span class="text-gray-600 font-medium">Phiên bản</span>
                        <span class="font-bold text-gray-900">v1.0.1</span>
                    </div>
                    <div class="flex items-center justify-between text-sm">
                        <span class="text-gray-600 font-medium">Máy chủ</span>
                        <div class="flex items-center gap-2">
                            <span class="w-2 h-2 bg-emerald-500 rounded-full animate-pulse"></span>
                            <span class="font-bold text-gray-900">Đang chạy</span>
                        </div>
                    </div>
                    <div class="flex items-center justify-between text-sm">
                        <span class="text-gray-600 font-medium">Cơ sở dữ liệu</span>
                        <span class="font-bold text-emerald-600">Kết nối tốt</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('layouts/footer') %>
