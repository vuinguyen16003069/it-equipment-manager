<%- include('../layouts/header') %>

<% const FLASH_MSG = {
  role_updated: 'Đã cập nhật vai trò người dùng.',
  password_reset: 'Đã đặt lại mật khẩu thành công.',
  deleted: 'Đã xóa người dùng.'
}; %>

<% if (flash && FLASH_MSG[flash]) { %>
<div class="mb-5 bg-gradient-to-r from-green-50 to-emerald-50 border-l-4 border-green-500 text-green-700 font-medium px-4 py-3 rounded-lg flex items-center justify-between shadow-sm">
    <span class="flex items-center gap-2">&#10003; <%= FLASH_MSG[flash] %></span>
    <button onclick="this.parentElement.remove()" class="text-green-400 hover:text-green-600 text-xl leading-none cursor-pointer transition-colors active:scale-110">&#10005;</button>
</div>
<% } %>

<!-- Toolbar -->
<div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
    <div>
        <p class="text-sm font-medium text-gray-600">
            Tổng <span class="text-lg font-bold text-blue-600"><%= pagination.total %></span> người dùng
        </p>
    </div>
    <!-- Search -->
    <form method="GET" action="/users" class="flex gap-2">
        <input type="text" name="search" value="<%= query.search || '' %>"
            placeholder="Tìm theo tên đăng nhập..."
            class="border border-gray-300 rounded-lg px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-gray-50 hover:bg-white min-w-64">
        <button type="submit" class="bg-gray-700 hover:bg-gray-800 text-white font-bold text-sm px-4 py-2 rounded-lg transition-all shadow-md cursor-pointer active:scale-95">
            &#128270; Tìm
        </button>
        <% if (query.search) { %>
        <a href="/users" class="bg-gray-200 hover:bg-gray-300 text-gray-700 font-bold text-sm px-4 py-2 rounded-lg transition-all cursor-pointer active:scale-95">
            &#10005;
        </a>
        <% } %>
    </form>
</div>

<!-- Table -->
<div class="bg-white rounded-xl shadow-md border border-gray-200 overflow-hidden">
    <% if (users.length === 0) { %>
    <div class="text-center py-16 px-4">
        <div class="text-6xl mb-4">&#128100;</div>
        <h3 class="text-xl font-bold text-gray-800 mb-2">Không tìm thấy người dùng</h3>
        <p class="text-gray-500">Hãy thử điều chỉnh từ khóa tìm kiếm</p>
    </div>
    <% } else { %>
    <div class="overflow-x-auto">
        <table class="w-full text-sm">
            <thead class="bg-gradient-to-r from-gray-50 to-gray-100 border-b border-gray-200">
                <tr>
                    <th class="text-left px-4 py-3.5 font-bold text-gray-600 text-xs uppercase tracking-wider">#</th>
                    <th class="text-left px-4 py-3.5 font-bold text-gray-600 text-xs uppercase tracking-wider">Tên đăng nhập</th>
                    <th class="text-left px-4 py-3.5 font-bold text-gray-600 text-xs uppercase tracking-wider">Vai trò</th>
                    <th class="text-left px-4 py-3.5 font-bold text-gray-600 text-xs uppercase tracking-wider">Ngày tạo</th>
                    <th class="text-center px-4 py-3.5 font-bold text-gray-600 text-xs uppercase tracking-wider">Thao tác</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                <% users.forEach(function(u, i) {
                    const isMe = String(u._id) === String(locals.user && locals.user.id);
                    const roleClass = u.role === 'admin'
                        ? 'bg-purple-100 text-purple-800 border-l-4 border-purple-500'
                        : 'bg-blue-100 text-blue-700 border-l-4 border-blue-400';
                    const roleLabel = u.role === 'admin' ? '&#128081; Admin' : '&#128100; User';
                    const rowNum = (pagination.page - 1) * pagination.pageSize + i + 1;
                    const dateStr = u.createdAt ? new Date(u.createdAt).toLocaleDateString('vi-VN') : '—';
                %>
                <tr class="hover:bg-blue-50 transition-colors group cursor-pointer">
                    <td class="px-4 py-3.5 text-gray-400 font-medium"><%= rowNum %></td>
                    <td class="px-4 py-3.5 font-semibold text-gray-800">
                        <%= u.username %>
                        <% if (isMe) { %>
                        <span class="ml-2 text-xs bg-green-100 text-green-700 font-bold px-2 py-0.5 rounded-full">Bạn</span>
                        <% } %>
                    </td>
                    <td class="px-4 py-3.5">
                        <span class="px-3 py-1 rounded-full text-xs font-bold <%- roleClass %>">
                            <%- roleLabel %>
                        </span>
                    </td>
                    <td class="px-4 py-3.5 text-gray-500 text-xs"><%= dateStr %></td>
                    <td class="px-4 py-3.5">
                        <div class="flex items-center justify-center gap-1.5">
                            <% if (!isMe) { %>
                            <a href="/users/<%= u._id %>/edit"
                               class="bg-amber-50 hover:bg-amber-500 text-amber-700 hover:text-white text-xs font-bold px-3 py-1.5 rounded-lg transition-all shadow-sm cursor-pointer active:scale-90">
                                &#9999; Chỉnh sửa
                            </a>
                            <form action="/users/<%= u._id %>/delete" method="POST"
                                  onsubmit="return confirm('Xóa người dùng: <%= u.username %>?')"
                                  class="inline">
                                 <button type="submit"
                                     class="bg-red-50 hover:bg-red-500 text-red-700 hover:text-white text-xs font-bold px-3 py-1.5 rounded-lg transition-all shadow-sm cursor-pointer active:scale-90">
                                     &#128465; Xóa
                                 </button>
                            </form>
                            <% } else { %>
                            <span class="text-xs text-gray-400 italic">—</span>
                            <% } %>
                        </div>
                    </td>
                </tr>
                <% }); %>
            </tbody>
        </table>
    </div>
    <% } %>
</div>

<!-- Pagination -->
<% if (pagination.totalPages > 1) { %>
<div class="mt-6 bg-white rounded-xl shadow-sm border border-gray-200 p-4">
    <div class="flex items-center justify-between">
        <p class="text-sm font-medium text-gray-600">
            Trang <span class="font-bold text-blue-600"><%= pagination.page %></span> / <span class="font-bold text-gray-800"><%= pagination.totalPages %></span>
        </p>
        <div class="flex gap-2">
            <% if (pagination.page > 1) { %>
             <a href="?<%= new URLSearchParams({...query, page: pagination.page - 1}).toString() %>"
                class="inline-flex items-center gap-1 px-4 py-2 border-2 border-gray-300 hover:border-blue-500 hover:text-blue-600 text-gray-600 font-bold rounded-lg transition-all cursor-pointer active:scale-95">
                 &#8592; Trước
             </a>
            <% } %>
            <% if (pagination.page < pagination.totalPages) { %>
             <a href="?<%= new URLSearchParams({...query, page: pagination.page + 1}).toString() %>"
                class="inline-flex items-center gap-1 px-4 py-2 border-2 border-gray-300 hover:border-blue-500 hover:text-blue-600 text-gray-600 font-bold rounded-lg transition-all cursor-pointer active:scale-95">
                 Sau &#8594;
             </a>
            <% } %>
        </div>
    </div>
</div>
<% } %>

<%- include('../layouts/footer') %>
