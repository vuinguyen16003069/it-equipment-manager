<%- include('../layouts/header') %>

<div class="max-w-2xl">
    <% if (error) { %>
    <div class="bg-red-50 border-l-4 border-red-500 text-red-700 rounded-lg px-4 py-3 mb-5 text-sm flex items-start gap-2">
        <span>&#9888;</span><span><%= error %></span>
    </div>
    <% } %>

    <div class="bg-white rounded-xl shadow-lg border border-gray-200 p-8 space-y-8">
        <div class="flex items-center gap-4 pb-6 border-b border-gray-200">
            <div class="w-14 h-14 rounded-full bg-gradient-to-br from-blue-400 to-indigo-600 flex items-center justify-center text-white text-2xl font-bold uppercase">
                <%= target.username.charAt(0) %>
            </div>
            <div>
                <h2 class="text-2xl font-bold text-gray-800"><%= target.username %></h2>
                <p class="text-sm text-gray-500">Tạo lúc: <%= new Date(target.createdAt).toLocaleString('vi-VN') %></p>
            </div>
        </div>

        <!-- Change Role -->
        <div>
            <h3 class="text-base font-bold text-gray-700 mb-4">&#128081; Thay đổi vai trò</h3>
            <form action="/users/<%= target._id %>/role" method="POST" class="flex items-center gap-3">
                <select name="role" class="border-2 border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-200 bg-gray-50 hover:bg-white transition cursor-pointer">
                    <option value="user"  <%= target.role === 'user'  ? 'selected' : '' %>>User – Chỉ xem</option>
                    <option value="admin" <%= target.role === 'admin' ? 'selected' : '' %>>Admin – Toàn quyền</option>
                </select>
                <button type="submit"
                    class="bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white font-bold px-5 py-2.5 rounded-lg transition-all shadow-md hover:shadow-lg active:scale-95 cursor-pointer">
                    &#128190; Lưu vai trò
                </button>
            </form>
            <p class="text-xs text-gray-500 mt-2">
                <strong>User:</strong> chỉ xem danh sách thiết bị. &nbsp;|&nbsp; <strong>Admin:</strong> thêm, sửa, xóa thiết bị và quản lý người dùng.
            </p>
        </div>

        <!-- Reset Password -->
        <div class="pt-6 border-t border-gray-200">
            <h3 class="text-base font-bold text-gray-700 mb-4">&#128274; Đặt lại mật khẩu</h3>
            <form action="/users/<%= target._id %>/reset-password" method="POST"
                  class="flex items-center gap-3"
                  onsubmit="return confirm('Xác nhận đặt lại mật khẩu cho <%= target.username %>?')">
                <div class="relative flex-1 max-w-xs">
                    <input type="password" name="newPassword" id="newPassword" required minlength="6"
                        placeholder="Mật khẩu mới (tối thiểu 6 ký tự)"
                        class="w-full border-2 border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-200 bg-gray-50 hover:bg-white pr-10 transition">
                    <button type="button" onclick="togglePwd(this, 'newPassword')"
                        class="absolute right-3 top-2.5 text-gray-400 hover:text-gray-600 p-0.5 cursor-pointer active:scale-110">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                    </button>
                </div>
                <button type="submit"
                    class="bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-600 hover:to-orange-600 text-white font-bold px-5 py-2.5 rounded-lg transition-all shadow-md hover:shadow-lg active:scale-95 cursor-pointer">
                    &#128260; Đặt lại
                </button>
            </form>
        </div>

        <!-- Back button -->
        <div class="pt-4 border-t border-gray-200 flex gap-3">
            <a href="/users" class="bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold px-6 py-3 rounded-lg transition-all cursor-pointer active:scale-95">
                &#8592; Quay lại
            </a>
        </div>
    </div>
</div>

<script>
    const EYE_OPEN = '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>';
    const EYE_CLOSED = '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24M1 1l22 22"/></svg>';
    function togglePwd(btn, id) {
        const input = document.getElementById(id);
        if (input.type === 'password') { input.type = 'text'; btn.innerHTML = EYE_CLOSED; }
        else { input.type = 'password'; btn.innerHTML = EYE_OPEN; }
    }
</script>

<%- include('../layouts/footer') %>
