<%- include('../layouts/header') %>

<% if (flash) { %>
<div class="mb-5 bg-green-50 border border-green-200 text-green-800 text-sm font-medium px-4 py-3 rounded-lg flex items-center gap-2">
    <span>&#10003;</span> <%= flash %>
</div>
<% } %>

<!-- Toolbar -->
<div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
    <p class="text-sm text-gray-500">
        Tổng <span class="font-semibold text-gray-800"><%= pagination.total %></span> thiết bị
    </p>
    <% if (locals.user && locals.user.role === 'admin') { %>
    <a href="/equipment/create"
       class="bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium px-4 py-2 rounded-lg transition-colors inline-flex items-center gap-2 self-start sm:self-auto">
        &#43; Thêm thiết bị
    </a>
    <% } %>
</div>

<!-- Search / Filter -->
<form method="GET" action="/equipment" class="bg-white rounded-xl shadow-sm border border-gray-100 p-4 mb-6 flex flex-wrap gap-3">
    <input type="text" name="search" value="<%= query.search || '' %>"
        placeholder="Tìm theo tên thiết bị..."
        class="border border-gray-300 rounded-lg px-3 py-2 text-sm flex-1 min-w-48 focus:outline-none focus:ring-2 focus:ring-blue-500">

    <select name="type" class="border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
        <option value="">-- Loại thiết bị --</option>
        <% EQUIPMENT_TYPES.forEach(function(t) { %>
        <option value="<%= t %>" <%= query.type === t ? 'selected' : '' %>><%= t %></option>
        <% }); %>
    </select>

    <select name="status" class="border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
        <option value="">-- Trạng thái --</option>
        <option value="available"   <%= query.status === 'available'   ? 'selected' : '' %>>Có sẵn</option>
        <option value="in-use"      <%= query.status === 'in-use'      ? 'selected' : '' %>>Đang sử dụng</option>
        <option value="maintenance" <%= query.status === 'maintenance' ? 'selected' : '' %>>Bảo trì</option>
        <option value="retired"     <%= query.status === 'retired'     ? 'selected' : '' %>>Đã thanh lý</option>
    </select>

    <button type="submit" class="bg-gray-700 hover:bg-gray-800 text-white text-sm px-4 py-2 rounded-lg transition-colors">
        Lọc
    </button>
    <a href="/equipment" class="text-sm text-gray-500 hover:text-gray-700 px-3 py-2 transition-colors">
        Xóa lọc
    </a>
</form>

<!-- Table -->
<div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-x-auto">
    <table class="w-full text-sm">
        <thead class="bg-gray-50 border-b border-gray-100">
            <tr>
                <th class="text-left px-4 py-3 font-semibold text-gray-500 text-xs uppercase tracking-wide">#</th>
                <th class="text-left px-4 py-3 font-semibold text-gray-500 text-xs uppercase tracking-wide">Tên thiết bị</th>
                <th class="text-left px-4 py-3 font-semibold text-gray-500 text-xs uppercase tracking-wide">Loại</th>
                <th class="text-left px-4 py-3 font-semibold text-gray-500 text-xs uppercase tracking-wide">Serial</th>
                <th class="text-left px-4 py-3 font-semibold text-gray-500 text-xs uppercase tracking-wide">Trạng thái</th>
                <th class="text-left px-4 py-3 font-semibold text-gray-500 text-xs uppercase tracking-wide">Người dùng</th>
                <% if (locals.user && locals.user.role === 'admin') { %>
                <th class="text-center px-4 py-3 font-semibold text-gray-500 text-xs uppercase tracking-wide">Thao tác</th>
                <% } %>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-50">
            <% if (items.length === 0) { %>
            <tr>
                <td colspan="7" class="text-center py-12 text-gray-400">
                    <div class="text-3xl mb-2">&#128) </div>
                    Không có thiết bị nào
                </td>
            </tr>
            <% } %>

            <% items.forEach(function(item, i) {
                const statusMap = {
                    'available':   ['bg-green-100 text-green-700',  'Có sẵn'],
                    'in-use':      ['bg-blue-100 text-blue-700',    'Đang dùng'],
                    'maintenance': ['bg-yellow-100 text-yellow-700','Bảo trì'],
                    'retired':     ['bg-red-100 text-red-700',      'Thanh lý'],
                };
                const statusInfo = statusMap[item.status] || ['bg-gray-100 text-gray-600', item.status];
                const rowNum = (pagination.page - 1) * pagination.pageSize + i + 1;
            %>
            <tr class="hover:bg-gray-50 transition-colors">
                <td class="px-4 py-3 text-gray-400"><%= rowNum %></td>
                <td class="px-4 py-3 font-medium text-gray-800"><%= item.name %></td>
                <td class="px-4 py-3 text-gray-600"><%= item.type %></td>
                <td class="px-4 py-3 font-mono text-xs text-gray-500"><%= item.serialNumber %></td>
                <td class="px-4 py-3">
                    <span class="px-2.5 py-1 rounded-full text-xs font-medium <%= statusInfo[0] %>">
                        <%= statusInfo[1] %>
                    </span>
                </td>
                <td class="px-4 py-3 text-gray-600"><%= item.assignedTo || '—' %></td>
                <% if (locals.user && locals.user.role === 'admin') { %>
                <td class="px-4 py-3">
                    <div class="flex items-center justify-center gap-2">
                        <a href="/equipment/edit/<%= item._id %>"
                           class="bg-amber-50 hover:bg-amber-100 text-amber-700 text-xs font-medium px-3 py-1.5 rounded-lg transition-colors">
                            Sửa
                        </a>
                        <form action="/equipment/delete/<%= item._id %>" method="POST"
                              data-msg="Xóa thiết bị: <%= item.name %>?"
                              onsubmit="return confirm(this.dataset.msg)">
                            <button type="submit"
                                class="bg-red-50 hover:bg-red-100 text-red-700 text-xs font-medium px-3 py-1.5 rounded-lg transition-colors">
                                Xóa
                            </button>
                        </form>
                    </div>
                </td>
                <% } %>
            </tr>
            <% }); %>
        </tbody>
    </table>
</div>

<% if (pagination.totalPages > 1) { %>
<div class="mt-5 flex items-center justify-between">
    <p class="text-sm text-gray-500">
        Trang <span class="font-semibold"><%= pagination.page %></span> / <%= pagination.totalPages %>
    </p>
    <div class="flex gap-2">
        <% if (pagination.page > 1) { %>
        <a href="?<%= new URLSearchParams({...query, page: pagination.page - 1}).toString() %>"
           class="px-3 py-1.5 text-sm border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors">
            &#8592; Trước
        </a>
        <% } %>
        <% if (pagination.page < pagination.totalPages) { %>
        <a href="?<%= new URLSearchParams({...query, page: pagination.page + 1}).toString() %>"
           class="px-3 py-1.5 text-sm border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors">
            Sau &#8594;
        </a>
        <% } %>
    </div>
</div>
<% } %>

<%- include('../layouts/footer') %>
