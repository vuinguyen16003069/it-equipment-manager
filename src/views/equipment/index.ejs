<%- include('../layouts/header') %>

<% if (flash) { %>
<div class="mb-5 bg-gradient-to-r from-green-50 to-emerald-50 border-l-4 border-green-500 text-green-700 font-medium px-4 py-3 rounded-lg flex items-center justify-between shadow-sm">
    <span class="flex items-center gap-2">&#10003; <%= flash %></span>
    <button onclick="this.parentElement.remove()" class="text-green-400 hover:text-green-600 text-xl leading-none">&#10005;</button>
</div>
<% } %>

<!-- Toolbar -->
<div class="mb-6 flex flex-col gap-4">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <div>
            <p class="text-sm font-medium text-gray-600">
                Tổng <span class="text-lg font-bold text-blue-600"><%= pagination.total %></span> thiết bị
            </p>
        </div>
        <div class="flex gap-2 flex-wrap">
            <% if (locals.user && locals.user.role === 'admin') { %>
            <a href="/equipment/create"
               class="bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 text-white font-bold text-sm px-4 py-2 rounded-lg transition-all shadow-md hover:shadow-lg transform hover:scale-105">
                &#43; Thêm thiết bị
            </a>
            <% } %>
            <button onclick="exportToCSV()" class="bg-amber-600 hover:bg-amber-700 text-white font-bold text-sm px-4 py-2 rounded-lg transition-all shadow-md hover:shadow-lg">
                &#128431; Export CSV
            </button>
        </div>
    </div>

    <!-- Search / Filter -->
    <form method="GET" action="/equipment" class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 flex flex-wrap gap-3">
        <input type="text" name="search" value="<%= query.search || '' %>"
            placeholder="Tìm theo tên, serial, người dùng..."
            class="flex-1 min-w-48 border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition bg-gray-50 hover:bg-white">

        <select name="type" class="border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 transition bg-gray-50 hover:bg-white">
            <option value="">-- Loại thiết bị --</option>
            <% EQUIPMENT_TYPES.forEach(function(t) { %>
            <option value="<%= t %>" <%= query.type === t ? 'selected' : '' %>><%= t %></option>
            <% }); %>
        </select>

        <select name="status" class="border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 transition bg-gray-50 hover:bg-white">
            <option value="">-- Trạng thái --</option>
            <option value="available"   <%= query.status === 'available'   ? 'selected' : '' %>>Có sẵn</option>
            <option value="in-use"      <%= query.status === 'in-use'      ? 'selected' : '' %>>Đang sử dụng</option>
            <option value="maintenance" <%= query.status === 'maintenance' ? 'selected' : '' %>>Bảo trì</option>
            <option value="retired"     <%= query.status === 'retired'     ? 'selected' : '' %>>Đã thanh lý</option>
        </select>

        <button type="submit" class="bg-gray-700 hover:bg-gray-800 text-white font-bold text-sm px-5 py-2.5 rounded-lg transition-all shadow-md">
            &#128270; Lọc
        </button>
        <a href="/equipment" class="bg-gray-200 hover:bg-gray-300 text-gray-700 font-bold text-sm px-4 py-2.5 rounded-lg transition-all">
            &#10005; Xóa lọc
        </a>
    </form>
</div>

<!-- Table -->
<div class="bg-white rounded-xl shadow-md border border-gray-200 overflow-hidden">
    <% if (items.length === 0) { %>
    <div class="text-center py-16 px-4">
        <div class="text-6xl mb-4">&#128230;</div>
        <h3 class="text-xl font-bold text-gray-800 mb-2">Không có thiết bị nào</h3>
        <p class="text-gray-500 mb-6">Hãy thêm thiết bị đầu tiên hoặc điều chỉnh bộ lọc tìm kiếm</p>
        <% if (locals.user && locals.user.role === 'admin') { %>
        <a href="/equipment/create" class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-bold px-6 py-3 rounded-lg transition-all shadow-md">
            &#43; Tạo thiết bị mới
        </a>
        <% } %>
    </div>
    <% } else { %>
    <div class="overflow-x-auto">
        <table class="w-full text-sm">
            <thead class="bg-gradient-to-r from-gray-50 to-gray-100 border-b border-gray-200">
                <tr>
                    <th class="text-left px-4 py-3.5 font-bold text-gray-600 text-xs uppercase tracking-wider">#</th>
                    <th class="text-left px-4 py-3.5 font-bold text-gray-600 text-xs uppercase tracking-wider">Tên thiết bị</th>
                    <th class="text-left px-4 py-3.5 font-bold text-gray-600 text-xs uppercase tracking-wider">Loại</th>
                    <th class="text-left px-4 py-3.5 font-bold text-gray-600 text-xs uppercase tracking-wider">Serial</th>
                    <th class="text-left px-4 py-3.5 font-bold text-gray-600 text-xs uppercase tracking-wider">Trạng thái</th>
                    <th class="text-left px-4 py-3.5 font-bold text-gray-600 text-xs uppercase tracking-wider">Người dùng</th>
                    <th class="text-left px-4 py-3.5 font-bold text-gray-600 text-xs uppercase tracking-wider">Ngày mua</th>
                    <% if (locals.user && locals.user.role === 'admin') { %>
                    <th class="text-center px-4 py-3.5 font-bold text-gray-600 text-xs uppercase tracking-wider">Thao tác</th>
                    <% } %>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                <% items.forEach(function(item, i) {
                    const statusMap = {
                        'available':   ['bg-green-100 text-green-800 border-l-4 border-green-500',  'Có sẵn'],
                        'in-use':      ['bg-blue-100 text-blue-800 border-l-4 border-blue-500',       'Đang dùng'],
                        'maintenance': ['bg-yellow-100 text-yellow-800 border-l-4 border-yellow-500','Bảo trì'],
                        'retired':     ['bg-red-100 text-red-800 border-l-4 border-red-500',         'Thanh lý'],
                    };
                    const statusInfo = statusMap[item.status] || ['bg-gray-100 text-gray-600', item.status];
                    const rowNum = (pagination.page - 1) * pagination.pageSize + i + 1;
                    const dateStr = item.purchaseDate ? new Date(item.purchaseDate).toLocaleDateString('vi-VN') : '—';
                %>
                <tr class="hover:bg-blue-50 transition-colors group">
                    <td class="px-4 py-3.5 text-gray-400 font-medium"><%= rowNum %></td>
                    <td class="px-4 py-3.5 font-semibold text-gray-800"><%= item.name %></td>
                    <td class="px-4 py-3.5 text-gray-600"><span class="px-3 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-700"><%= item.type %></span></td>
                    <td class="px-4 py-3.5 font-mono text-xs text-gray-500 bg-gray-50 px-3 py-1 rounded">
                        <span class="select-all"><%= item.serialNumber %></span>
                    </td>
                    <td class="px-4 py-3.5">
                        <span class="px-3 py-1 rounded-full text-xs font-bold <%= statusInfo[0] %>">
                            <%= statusInfo[1] %>
                        </span>
                    </td>
                    <td class="px-4 py-3.5 text-gray-600"><%= item.assignedTo || '—' %></td>
                    <td class="px-4 py-3.5 text-gray-500 text-xs"><%= dateStr %></td>
                    <% if (locals.user && locals.user.role === 'admin') { %>
                    <td class="px-4 py-3.5">
                        <div class="flex items-center justify-center gap-1.5 opacity-0 group-hover:opacity-100 transition-opacity">
                            <a href="/equipment/edit/<%= item._id %>"
                               class="bg-amber-50 hover:bg-amber-500 text-amber-700 hover:text-white text-xs font-bold px-3 py-1.5 rounded-lg transition-all shadow-sm">
                                &#9999; Sửa
                            </a>
                            <form action="/equipment/delete/<%= item._id %>" method="POST"
                                  data-msg="Xóa thiết bị: <%= item.name %>?"
                                  onsubmit="return confirm(this.dataset.msg)"
                                  class="inline">
                                <button type="submit"
                                    class="bg-red-50 hover:bg-red-500 text-red-700 hover:text-white text-xs font-bold px-3 py-1.5 rounded-lg transition-all shadow-sm">
                                    &#128465; Xóa
                                </button>
                            </form>
                        </div>
                    </td>
                    <% } %>
                </tr>
                <% }); %>
            </tbody>
        </table>
    </div>
    <% } %>
</div>

<!-- Pagination -->
<% if (pagination.totalPages > 1) { %>
<div class="mt-6 bg-white rounded-xl shadow-sm border border-gray-200 p-4">
    <div class="flex items-center justify-between">
        <p class="text-sm font-medium text-gray-600">
            Trang <span class="font-bold text-blue-600"><%= pagination.page %></span> / <span class="font-bold text-gray-800"><%= pagination.totalPages %></span>
        </p>
        <div class="flex gap-2">
            <% if (pagination.page > 1) { %>
            <a href="?<%= new URLSearchParams({...query, page: pagination.page - 1}).toString() %>"
               class="inline-flex items-center gap-1 px-4 py-2 border-2 border-gray-300 hover:border-blue-500 hover:text-blue-600 text-gray-600 font-bold rounded-lg transition-all">
                &#8592; Trước
            </a>
            <% } %>
            <% if (pagination.page < pagination.totalPages) { %>
            <a href="?<%= new URLSearchParams({...query, page: pagination.page + 1}).toString() %>"
               class="inline-flex items-center gap-1 px-4 py-2 border-2 border-gray-300 hover:border-blue-500 hover:text-blue-600 text-gray-600 font-bold rounded-lg transition-all">
                Sau &#8594;
            </a>
            <% } %>
        </div>
    </div>
</div>
<% } %>

<script>
    function exportToCSV() {
        const headers = ['#', 'Tên', 'Loại', 'Serial', 'Trạng thái', 'Người dùng', 'Ngày mua'];
        const rows = [];
        document.querySelectorAll('tbody tr').forEach((tr, idx) => {
            const cells = tr.querySelectorAll('td');
            rows.push([
                idx + 1,
                cells[1].textContent.trim(),
                cells[2].textContent.trim(),
                cells[3].textContent.trim(),
                cells[4].textContent.trim(),
                cells[5].textContent.trim(),
                cells[6].textContent.trim()
            ]);
        });
        const csv = [headers, ...rows].map(r => r.map(c => `"${c}"`).join(',')).join('\n');
        const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
        const link = document.createElement('a');
        link.href = URL.createObjectURL(blob);
        link.download = `thiết-bị-IT-${new Date().toISOString().split('T')[0]}.csv`;
        link.click();
    }
</script>

<%- include('../layouts/footer') %>
