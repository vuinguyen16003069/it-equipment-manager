<%- include('../layouts/header') %>

<div class="max-w-3xl">
    <% if (error) { %>
    <div class="bg-red-50 border-l-4 border-red-500 text-red-700 rounded-lg px-4 py-3 mb-5 text-sm flex items-start gap-2">
        <span>&#9888;</span><span><%= error %></span>
    </div>
    <% } %>

    <div class="bg-white rounded-xl shadow-lg border border-gray-200 p-8">
        <h2 class="text-2xl font-bold mb-6 text-gray-800">&#9999; Chỉnh sửa thiết bị</h2>
        <form action="/equipment/edit/<%= item._id %>" method="POST" enctype="multipart/form-data" class="space-y-6" onchange="markUnsaved()">

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div class="sm:col-span-2">
                    <label class="block text-sm font-bold text-gray-700 mb-2">Ảnh thiết bị</label>
                    <div class="flex items-center gap-4">
                        <div id="image-preview" class="w-24 h-24 bg-gray-100 rounded-lg border-2 border-gray-300 flex items-center justify-center overflow-hidden">
                            <% if (item.imageUrl) { %>
                                <img src="<%= item.imageUrl %>" class="w-full h-full object-cover">
                            <% } else { %>
                                <span class="text-gray-400 text-xs text-center px-1">Chưa có ảnh</span>
                            <% } %>
                        </div>
                        <div class="flex-1">
                            <input type="file" name="image" id="image-input" accept="image/*"
                                class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-amber-50 file:text-amber-700 hover:file:bg-amber-100 transition">
                            <p class="text-xs text-gray-500 mt-1">Chọn ảnh mới để thay thế (Tối đa 25MB)</p>
                        </div>
                    </div>
                </div>

                <div class="sm:col-span-2">
                    <label class="block text-sm font-bold text-gray-700 mb-2">Tên thiết bị <span class="text-red-500">*</span></label>
                    <input type="text" name="name" value="<%= item.name %>" required
                        class="w-full border-2 border-gray-300 rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-200 transition bg-gray-50 hover:bg-white"
                        pattern="^.{2,}$" title="Tên phải có ít nhất 2 ký tự">
                </div>

                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2">Loại thiết bị <span class="text-red-500">*</span></label>
                    <select name="type" required class="w-full border-2 border-gray-300 rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-200 transition bg-gray-50 hover:bg-white cursor-pointer">
                        <% EQUIPMENT_TYPES.forEach(function(t) { %>
                        <option value="<%= t %>" <%= item.type === t ? 'selected' : '' %>><%= t %></option>
                        <% }); %>
                    </select>
                </div>

                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2">Số Serial <span class="text-red-500">*</span></label>
                    <input type="text" name="serialNumber" value="<%= item.serialNumber %>" required
                        class="w-full border-2 border-gray-300 rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-200 transition bg-gray-50 hover:bg-white font-mono">
                </div>

                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2">Trạng thái <span class="text-red-500">*</span></label>
                    <select name="status" required class="w-full border-2 border-gray-300 rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-200 transition bg-gray-50 hover:bg-white cursor-pointer">
                        <option value="available"   <%= item.status === 'available'   ? 'selected' : '' %>>Có sẵn</option>
                        <option value="in-use"      <%= item.status === 'in-use'      ? 'selected' : '' %>>Đang sử dụng</option>
                        <option value="maintenance" <%= item.status === 'maintenance' ? 'selected' : '' %>>Bảo trì</option>
                        <option value="retired"     <%= item.status === 'retired'     ? 'selected' : '' %>>Đã thanh lý</option>
                    </select>
                </div>

                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2">Người sử dụng</label>
                    <input type="text" name="assignedTo" value="<%= item.assignedTo %>"
                        class="w-full border-2 border-gray-300 rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-200 transition bg-gray-50 hover:bg-white">
                </div>

                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2">Ngày mua</label>
                    <input type="date" name="purchaseDate"
                        value="<%= item.purchaseDate ? new Date(item.purchaseDate).toISOString().split('T')[0] : '' %>"
                        class="w-full border-2 border-gray-300 rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-200 transition bg-gray-50 hover:bg-white">
                </div>

                <div class="sm:col-span-2">
                    <label class="block text-sm font-bold text-gray-700 mb-2">Mô tả</label>
                    <textarea name="description" rows="4"
                        class="w-full border-2 border-gray-300 rounded-lg px-4 py-3 text-sm focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-200 transition bg-gray-50 hover:bg-white resize-none"
                        maxlength="500"><%= item.description %></textarea>
                    <p class="text-xs text-gray-500 mt-1">Tối đa 500 ký tự</p>
                </div>
            </div>

            <div class="flex gap-3 pt-4 border-t border-gray-200">
                <button type="submit"
                    class="bg-gradient-to-r from-amber-600 to-amber-700 hover:from-amber-700 hover:to-amber-800 text-white font-bold px-6 py-3 rounded-lg transition-all shadow-md hover:shadow-lg transform hover:scale-105 active:scale-95 cursor-pointer">
                    &#128190; Lưu thay đổi
                </button>
                <a href="/equipment"
                   class="bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold px-6 py-3 rounded-lg transition-all cursor-pointer active:scale-95">
                    &#10005; Hủy
                </a>
            </div>
        </form>
    </div>
</div>

<script>
    let isSaved = true;
    function markUnsaved() {
        isSaved = false;
    }
    window.addEventListener('beforeunload', (e) => {
        if (!isSaved) {
            e.returnValue = '';
        }
    });
    document.querySelector('form').addEventListener('submit', () => {
        isSaved = true;
    });

    // Preview ảnh
    document.getElementById('image-input').addEventListener('change', function(e) {
        const preview = document.getElementById('image-preview');
        const file = e.target.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function(event) {
                preview.innerHTML = `<img src="${event.target.result}" class="w-full h-full object-cover">`;
            }
            reader.readAsDataURL(file);
        }
    });
</script>

<%- include('../layouts/footer') %>
