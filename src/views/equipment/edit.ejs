<%- include('../layouts/header') %>

<div class="max-w-2xl">
    <% if (error) { %>
    <div class="bg-red-50 border border-red-200 text-red-700 rounded-lg px-4 py-3 mb-5 text-sm flex items-start gap-2">
        <span>&#9888;</span><span><%= error %></span>
    </div>
    <% } %>

    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
        <form action="/equipment/edit/<%= item._id %>" method="POST" class="space-y-5">

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div class="sm:col-span-2">
                    <label class="block text-sm font-medium text-gray-700 mb-1.5">Tên thiết bị <span class="text-red-500">*</span></label>
                    <input type="text" name="name" value="<%= item.name %>"
                        class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1.5">Loại thiết bị <span class="text-red-500">*</span></label>
                    <select name="type" class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <% EQUIPMENT_TYPES.forEach(function(t) { %>
                        <option value="<%= t %>" <%= item.type === t ? 'selected' : '' %>><%= t %></option>
                        <% }); %>
                    </select>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1.5">Số Serial <span class="text-red-500">*</span></label>
                    <input type="text" name="serialNumber" value="<%= item.serialNumber %>"
                        class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 font-mono">
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1.5">Trạng thái <span class="text-red-500">*</span></label>
                    <select name="status" class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <option value="available"   <%= item.status === 'available'   ? 'selected' : '' %>>Có sẵn</option>
                        <option value="in-use"      <%= item.status === 'in-use'      ? 'selected' : '' %>>Đang sử dụng</option>
                        <option value="maintenance" <%= item.status === 'maintenance' ? 'selected' : '' %>>Bảo trì</option>
                        <option value="retired"     <%= item.status === 'retired'     ? 'selected' : '' %>>Đã thanh lý</option>
                    </select>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1.5">Người sử dụng</label>
                    <input type="text" name="assignedTo" value="<%= item.assignedTo %>"
                        class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1.5">Ngày mua</label>
                    <input type="date" name="purchaseDate"
                        value="<%= item.purchaseDate ? new Date(item.purchaseDate).toISOString().split('T')[0] : '' %>"
                        class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>

                <div class="sm:col-span-2">
                    <label class="block text-sm font-medium text-gray-700 mb-1.5">Mô tả</label>
                    <textarea name="description" rows="3"
                        class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 resize-none"><%= item.description %></textarea>
                </div>
            </div>

            <div class="flex gap-3 pt-2">
                <button type="submit"
                    class="bg-amber-500 hover:bg-amber-600 text-white font-semibold text-sm px-6 py-2.5 rounded-lg transition-colors">
                    Lưu thay đổi
                </button>
                <a href="/equipment"
                   class="bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold text-sm px-6 py-2.5 rounded-lg transition-colors">
                    Hủy
                </a>
            </div>
        </form>
    </div>
</div>

<%- include('../layouts/footer') %>
