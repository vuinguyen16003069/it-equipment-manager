{
  "name": "demo-it-inventory-management",
  "version": "1.0.0",
  "description": "Ứng dụng quản lý danh sách thiết bị IT nội bộ",
  "license": "MIT",
  "author": "vuinguyen16003069 (Vuiz)",
  "type": "commonjs",
  "main": "src/bin/www.js",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": ["it", "inventory", "management", "express", "nodejs", "ejs", "tailwindcss", "jwt"],
  "scripts": {
    "start": "node src/bin/www.js",
    "dev": "nodemon -w src -w .env src/bin/www.js",
    "build": "npm install && npm run tw:build",
    "tw:build": "npx @tailwindcss/cli -i ./src/input.css -o ./src/public/stylesheets/output.css",
    "tw:watch": "npx @tailwindcss/cli -i ./src/input.css -o ./src/public/stylesheets/output.css --watch",
    "seed": "node src/bin/seed.js",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:fix:unsafe": "biome check --write --unsafe ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vuinguyen16003069/it-equipment-manager.git"
  },
  "dependencies": {
    "axios": "^1.16.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.3.1",
    "ejs": "^4.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "form-data": "^4.0.5",
    "helmet": "^8.1.0",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.3.0",
    "morgan": "^1.10.1",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@tailwindcss/cli": "^4.2.1",
    "nodemon": "^3.1.11",
    "tailwindcss": "^4.2.1"
  }
}
